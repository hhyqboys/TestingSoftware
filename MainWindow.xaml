<Window
    x:Class="TestingSoftware.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:TestingSoftware.Converters"
    xmlns:ctrl="clr-namespace:TestingSoftware.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:TestingSoftware"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="clr-namespace:TestingSoftware.View"
    Width="1280"
    Height="800"
    MinWidth="1080"
    MinHeight="660"
    Icon="pack://application:,,,/Resources/ElectricControl.ico"
    mc:Ignorable="d">
    <Window.Resources>
        <conv:EmptyStringConverter x:Key="EmptyStringConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:BoolFalseToVisibilityConverter x:Key="BoolFalseToVisibilityConverter" />
        <LinearGradientBrush x:Key="xForeground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0" Color="#1E54C2" />
            <GradientStop Offset="1.0" Color="#072A77" />
        </LinearGradientBrush>
        <Style x:Key="xIcon" TargetType="{x:Type icon:PackIconBase}">
            <Setter Property="Foreground" Value="{StaticResource xForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#808080" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!--  工具栏通用按钮外观  -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#3C4859" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style x:Key="ToolbarSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="10,4" />
            <Setter Property="Background" Value="#DCE1E8" />
        </Style>
        <Style x:Key="DisabledComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0" />
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Command="{Binding OpenAction}" Modifiers="Ctrl" />
        <KeyBinding Key="F4" Command="{Binding ExitAction}" Modifiers="Alt" />
    </Window.InputBindings>
    <Window.Title>
        <Binding Path="FileName" StringFormat="Testing Software - {0}" />
    </Window.Title>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="2" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="2" />
            <RowDefinition Height="*" />
            <RowDefinition Height="2" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" HorizontalAlignment="Stretch">
            <MenuItem Header="文件">
                <MenuItem Command="{Binding OpenAction}" Header="打开文件" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Command="{Binding SaveAction}" Header=" 保存" InputGestureText="Ctrl+S" />
                <Separator />
                <MenuItem Command="{Binding ExitAction}" Header="退出" InputGestureText="Alt+F4" />
            </MenuItem>
        </Menu>

        <TextBlock Grid.Row="1" Margin="10,6" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="20" FontWeight="Bold" Text="{Binding Model.Title, TargetNullValue='未命名项目'}" />

        <Border Grid.Row="2" HorizontalAlignment="Stretch" Background="#cccccc" />

        <!--  第 1 行：设备连接 + 扫 SN + 测试操作（同一行）  -->
        <DockPanel Grid.Row="3" Margin="10,6" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding StartJobAction}" ToolTip="开始任务">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconPhosphorIcons Kind="PlayLight" Style="{StaticResource xIcon}" />
                        <TextBlock Margin="6,0,0,0" Text="开始" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding StopJobAction}" ToolTip="停止任务">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconPhosphorIcons Kind="StopLight" Style="{StaticResource xIcon}" />
                        <TextBlock Margin="6,0,0,0" Text="停止" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding RetestJobAction}" ToolTip="复测当前任务">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconPhosphorIcons Kind="RepeatLight" Style="{StaticResource xIcon}" />
                        <TextBlock Margin="6,0,0,0" Text="复测" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!--  串口 + 扫描  -->
                <TextBlock Style="{StaticResource ToolbarLabel}" Text="串口" />
                <ComboBox MinWidth="72" Style="{StaticResource DisabledComboBoxStyle}"
                          ItemsSource="{Binding SerialPortList}" SelectedItem="{Binding SelectedSerialPort}" />
                <Button Width="80" Height="38" Margin="2,0" Padding="6,2" BorderThickness="0"
                        Command="{Binding ScanSerialAction}" FontSize="15" ToolTip="扫描串口">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconOcticons Kind="Codescan" Style="{StaticResource xIcon}" />
                        <TextBlock Margin="4,0,0,0" Text="扫描" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource ToolbarSeparator}" />

                <!--  蓝牙 MAC 直连  -->
                <TextBlock Style="{StaticResource ToolbarLabel}" Text="蓝牙MAC" />
                <TextBox Width="160" Height="36" Margin="6,0" VerticalAlignment="Center" FontSize="15"
                         MaxLength="17" InputMethod.IsInputMethodEnabled="False"
                         GotFocus="MacAddressTextBox_GotFocus"
                         KeyDown="MacAddressTextBox_KeyDown"
                         Text="{Binding MacAddressInput}" />
                <Button Width="92" Height="38" Margin="2,0" Padding="6,2"
                        Command="{Binding ConnectAction}" FontSize="15" ToolTip="{Binding ConnectionLabel}">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconPhosphorIcons Kind="PlugsLight" Style="{StaticResource xIcon}"
                            Visibility="{Binding IsConnectButtonEnabled, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <icon:PackIconPhosphorIcons Kind="PlugsConnectedLight" Style="{StaticResource xIcon}"
                            Visibility="{Binding IsConnectButtonEnabled, Converter={StaticResource BoolFalseToVisibilityConverter}}" />
                        <TextBlock Margin="4,0,0,0" Text="{Binding ConnectionLabel}" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource ToolbarSeparator}" />

                <!--  SN 扫描  -->
                <TextBlock Style="{StaticResource ToolbarLabel}" Text="SN" />
                <TextBox x:Name="ScanSnTextBox" Width="220" Height="36" Margin="6,0" VerticalAlignment="Center"
                         FontSize="17" FontWeight="Bold"
                         GotFocus="ScanSnTextBox_GotFocus" InputMethod.IsInputMethodEnabled="False"
                         KeyDown="ScanSnTextBox_KeyDown" Text="{Binding ScanSn}" />
                <TextBlock Style="{StaticResource ToolbarLabel}" Text="复查数据" />
                <Border MinWidth="100" Height="32" Margin="6,0" Padding="6,0" VerticalAlignment="Center"
                        Background="White" BorderBrush="#E1E6ED" BorderThickness="1" CornerRadius="4">
                    <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="#e53935"
                               Text="{Binding ReTestSn}" />
                </Border>
            </WrapPanel>
        </DockPanel>

        <Border Grid.Row="4" HorizontalAlignment="Stretch" Background="#cccccc" />

        <!--  主体：左侧测试项列表 + 右侧实时仪表  -->
        <Grid Grid.Row="5" Margin="10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0" ItemsSource="{Binding VisibleJobs}" SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="IsSelected" Value="False" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#f0f0f0" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="80" Header="编号">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" FontSize="18" Text="{Binding SerialNumber}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="660" Header="测试项">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" FontSize="18" Text="{Binding JobName}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="50" Header="状态">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid HorizontalAlignment="Right">
                                            <Ellipse Width="22" Height="22">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#888888" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="1">
                                                                <Setter Property="Fill" Value="#f7c320" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="2">
                                                                <Setter Property="Fill" Value="#32b852" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="-1">
                                                                <Setter Property="Fill" Value="#e53935" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <Border Grid.Column="1" Background="#f0f2f5" />

            <!--  右侧实时信息（仪表 + 故障码）  -->
            <Border Grid.Column="2" Margin="8,0,0,0"
                    Background="White" BorderBrush="#E1E6ED" BorderThickness="1" CornerRadius="8">
                <DockPanel Margin="10,8,10,10">
                    <!--  面板标题 + 开关  -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="17" FontWeight="Bold" Foreground="#1B2533" Text="实时信息" />
                            <TextBlock MaxWidth="300" FontSize="11" Foreground="#7A8797"
                                       Text="{Binding Monitor.MonitorStatus}" TextWrapping="Wrap" />
                            <TextBlock FontSize="11" Foreground="#9AA6B6"
                                       Text="{Binding Monitor.FrameCountText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Margin="0,0,0,4" HorizontalAlignment="Right" FontSize="11" Foreground="#7A8797"
                                       Text="{Binding Monitor.FrameRateText}" />
                            <Button Width="94" Height="30" Padding="6,2" FontSize="13"
                                    Command="{Binding Monitor.ToggleMonitorCommand}"
                                    Content="{Binding Monitor.ToggleButtonText}" />
                        </StackPanel>
                    </Grid>

                    <!--  故障码（故障可能多项，逐项列出）  -->
                    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10" Background="#FBFCFE"
                            BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <Grid>
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="#1B2533" Text="故障码" />
                                <TextBlock HorizontalAlignment="Right" FontSize="16" FontWeight="Bold" Text="{Binding Monitor.FaultCodeText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#2FA84F" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Monitor.HasFault}" Value="True">
                                                    <Setter Property="Foreground" Value="#e53935" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock Margin="0,2,0,4" FontSize="12" Text="{Binding Monitor.FaultSummaryText}"
                                       Visibility="{Binding Monitor.HasFault, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2FA84F" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Monitor.HasFault}" Value="True">
                                                <Setter Property="Foreground" Value="#e53935" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Monitor.FaultItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,5,5" Padding="7,3" Background="#FDECEA"
                                                    BorderBrush="#F6C9C4" BorderThickness="1" CornerRadius="4">
                                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="#C62828" Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Margin="0,2,0,0" FontSize="13" FontWeight="Bold" Foreground="#2FA84F" Text="● 无故障，运行正常"
                                       Visibility="{Binding Monitor.HasFault, Converter={StaticResource BoolFalseToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <!--  三个仪表  -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ctrl:GaugeControl
                                Height="142"
                                Margin="0,2"
                                Accent="#2F6FD0"
                                Caption="母线电流"
                                Maximum="{Binding Monitor.BusCurrentMaximum}"
                                Minimum="0"
                                Unit="A"
                                Value="{Binding Monitor.BusCurrentValue}"
                                ValueFormat="F1" />
                            <Border Height="1" Margin="6,2" Background="#EDF1F6" />
                            <ctrl:GaugeControl
                                Height="142"
                                Margin="0,2"
                                Accent="#178FA0"
                                Caption="转速"
                                Maximum="{Binding Monitor.MotorSpeedMaximum}"
                                Minimum="0"
                                Unit="RPM"
                                Value="{Binding Monitor.MotorSpeedValue}"
                                ValueFormat="F0" />
                            <Border Height="1" Margin="6,2" Background="#EDF1F6" />
                            <ctrl:GaugeControl
                                Height="142"
                                Margin="0,2"
                                Caption="电机温度"
                                HeatMode="True"
                                Maximum="{Binding Monitor.MotorTemperatureMaximum}"
                                Minimum="0"
                                Unit="℃"
                                Value="{Binding Monitor.MotorTemperatureValue}"
                                ValueFormat="F1" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="6" HorizontalAlignment="Stretch" Background="#cccccc" />

        <!--  底部：测试状态  -->
        <Border Grid.Row="7" Padding="12,8" Background="#FAFBFD">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#B0B8C4" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="0">
                                        <Setter Property="Fill" Value="#8E9AAB" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="1">
                                        <Setter Property="Fill" Value="#f7c320" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="2">
                                        <Setter Property="Fill" Value="#32b852" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="-1">
                                        <Setter Property="Fill" Value="#e53935" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#999999" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="0">
                                        <Setter Property="Foreground" Value="#000000" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="1">
                                        <Setter Property="Foreground" Value="#c99b00" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="2">
                                        <Setter Property="Foreground" Value="#32b852" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="-1">
                                        <Setter Property="Foreground" Value="#e53935" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <TextBlock.Text>
                            <Binding FallbackValue="未执行测试项目" Path="TestStatusInfo" TargetNullValue="未执行测试项目">
                                <Binding.Converter>
                                    <conv:EmptyStringConverter />
                                </Binding.Converter>
                            </Binding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#7A8797" Text="设备" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"
                               Foreground="#3C4859" Text="{Binding ConnectionLabel}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
