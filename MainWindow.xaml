<Window
    x:Class="TestingSoftware.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:TestingSoftware.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:TestingSoftware"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="clr-namespace:TestingSoftware.View"
    Width="1200"
    Height="600"
    Icon="pack://application:,,,/Resources/ElectricControl.ico"
    mc:Ignorable="d">
    <Window.Resources>
        <conv:EmptyStringConverter x:Key="EmptyStringConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:BoolFalseToVisibilityConverter x:Key="BoolFalseToVisibilityConverter" />
        <LinearGradientBrush x:Key="xForeground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0" Color="#1E54C2" />
            <GradientStop Offset="1.0" Color="#072A77" />
        </LinearGradientBrush>
        <Style x:Key="xIcon" TargetType="{x:Type icon:PackIconBase}">
            <Setter Property="Foreground" Value="{StaticResource xForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#808080" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DisabledComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Popup
                                x:Name="PART_Popup"
                                Grid.ColumnSpan="2"
                                Margin="1"
                                AllowsTransparency="true"
                                IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                Placement="Bottom">
                                <Border
                                    MinWidth="{Binding ActualWidth, ElementName=templateRoot}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="White"
                                    BorderBrush="#ACACAC"
                                    BorderThickness="1">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <ToggleButton
                                x:Name="toggleButton"
                                Grid.ColumnSpan="2"
                                ClickMode="Press"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border
                                            x:Name="Chrome"
                                            Background="White"
                                            BorderBrush="#ACACAC"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            SnapsToDevicePixels="true">
                                            <Path
                                                x:Name="arrow"
                                                Width="6"
                                                Height="4"
                                                Margin="0,0,10,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Data="M 0,0 L 3,3 L 6,0 Z"
                                                Fill="#606060" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Chrome" Property="Background" Value="#000" />
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="red" />
                                                <Setter TargetName="arrow" Property="Fill" Value="#BFBFBF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter
                                Margin="8,0,24,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                IsHitTestVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#888888" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Command="{Binding OpenAction}" Modifiers="Ctrl" />
        <KeyBinding Key="F4" Command="{Binding ExitAction}" Modifiers="Alt" />
    </Window.InputBindings>
    <Window.Title>
        <Binding Path="FileName" StringFormat="Testing Software - {0}" />
    </Window.Title>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" HorizontalAlignment="Stretch">
            <MenuItem Header="文件">
                <MenuItem Command="{Binding OpenAction}" Header="打开文件" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Command="{Binding SaveAction}" Header=" 保存" InputGestureText="Ctrl+S" />
                <Separator />
                <MenuItem Command="{Binding ExitAction}" Header="退出" InputGestureText="Alt+F4" />
            </MenuItem>
        </Menu>

        <TextBlock Grid.Row="1" Margin="10,8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="Bold"
                   Text="{Binding Model.Title, TargetNullValue='未命名项目'}" />

        <Border Grid.Row="2" Margin="0,1" HorizontalAlignment="Stretch" Background="#cccccc" />

        <DockPanel Grid.Row="3" Margin="5" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" FontSize="20" Text="串口" />
                <ComboBox MinWidth="50" Margin="5" VerticalAlignment="Center" FontSize="20"
                          ItemsSource="{Binding SerialPortList}" SelectedItem="{Binding SelectedSerialPort}" />
                <Button Width="100" Height="50" Margin="5" Padding="5,3,5,3" VerticalAlignment="Center"
                        BorderThickness="0" Command="{Binding ScanSerialAction}" FontSize="20" ToolTip="Scan">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconOcticons Width="25" Height="25" Kind="Codescan" Style="{StaticResource xIcon}" />
                        <TextBlock Margin="4,0,0,0" Text="扫描" />
                    </StackPanel>
                </Button>
                <!--  蓝牙MAC地址直连输入  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="5" VerticalAlignment="Center" FontSize="20" Text="蓝牙MAC:" />
                    <TextBox Width="180" Height="40" Margin="5" VerticalAlignment="Center" FontSize="20"
                             MaxLength="12" InputMethod.IsInputMethodEnabled="False"
                             GotFocus="MacAddressTextBox_GotFocus"
                             KeyDown="MacAddressTextBox_KeyDown"
                             Text="{Binding MacAddressInput}" />
                </StackPanel>
                <!--  原蓝牙搜索ComboBox和扫描按钮已隐藏，保留代码以备恢复
                <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Margin="5" VerticalAlignment="Center" FontSize="20" Text="测试设备:" />
                    <ComboBox MinWidth="100" MinHeight="50" Margin="5" VerticalAlignment="Center" FontSize="20"
                              IsEnabled="{Binding IsScanning}" ItemsSource="{Binding SlaveDevices}"
                              SelectedItem="{Binding SelectedSlaveDevInfo}" Style="{StaticResource DisabledComboBoxStyle}" />
                    <Button Width="100" Height="50" Margin="5" Padding="5,3,5,3" VerticalAlignment="Center"
                            BorderThickness="0" Command="{Binding ScanAction}" FontSize="20" ToolTip="Scan">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconOcticons Width="25" Height="25" Kind="Codescan" Style="{StaticResource xIcon}" />
                            <TextBlock Margin="4,0,0,0" Text="扫描" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                -->
                <StackPanel Orientation="Horizontal">
                    <Button Width="100" Height="50" Margin="5" Padding="5,3,5,3" VerticalAlignment="Center"
                            Command="{Binding ConnectAction}" FontSize="20" ToolTip="{Binding ConnectionLabel}">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconPhosphorIcons Width="25" Height="25" Kind="PlugsLight"
                                Style="{StaticResource xIcon}"
                                Visibility="{Binding IsConnectButtonEnabled, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <icon:PackIconPhosphorIcons Width="25" Height="25" Kind="PlugsConnectedLight"
                                Style="{StaticResource xIcon}"
                                Visibility="{Binding IsConnectButtonEnabled, Converter={StaticResource BoolFalseToVisibilityConverter}}" />
                            <TextBlock Margin="4,0,0,0" Text="{Binding ConnectionLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="4" Margin="0,1" HorizontalAlignment="Stretch" Background="#cccccc" />
        <DockPanel Grid.Row="5" Margin="5">
            <TextBlock VerticalAlignment="Center" FontSize="25" Text="SN：" />
            <TextBox Width="310" Height="40" Margin="8,0" VerticalAlignment="Center" FontSize="25"
                     GotFocus="ScanSnTextBox_GotFocus" InputMethod.IsInputMethodEnabled="False"
                     KeyDown="ScanSnTextBox_KeyDown" Text="{Binding ScanSn}" />
            <TextBlock VerticalAlignment="Center" FontSize="25" Text="复查数据：" />
            <TextBlock Width="150" VerticalAlignment="Center" Background="White" FontSize="25"
                       FontWeight="Bold" Foreground="Red" Text="{Binding ReTestSn}" />
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Width="100" Height="50" Margin="5" Padding="8,4" VerticalAlignment="Center"
                        Command="{Binding StartJobAction}" FontSize="20" ToolTip="开始任务">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconPhosphorIcons Width="25" Height="25" Kind="PlayLight" Style="{StaticResource xIcon}" />
                        <TextBlock Margin="4,0,0,0" Text="开始" />
                    </StackPanel>
                </Button>
                <Button Width="100" Height="50" Margin="5" Padding="8,4" VerticalAlignment="Center"
                        Command="{Binding StopJobAction}" FontSize="20" ToolTip="停止任务">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconPhosphorIcons Width="25" Height="25" Kind="StopLight" Style="{StaticResource xIcon}" />
                        <TextBlock Margin="4,0,0,0" Text="停止" />
                    </StackPanel>
                </Button>
                <Button Width="100" Height="50" Margin="5" Padding="8,4" VerticalAlignment="Center"
                        Command="{Binding RetestJobAction}" FontSize="20" ToolTip="复测当前任务">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconPhosphorIcons Width="25" Height="25" Kind="RepeatLight" Style="{StaticResource xIcon}" />
                        <TextBlock Margin="4,0,0,0" Text="复测" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="6" Margin="0,1" HorizontalAlignment="Stretch" Background="#cccccc" />
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListView Grid.Column="0" ItemsSource="{Binding VisibleJobs}" SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="IsSelected" Value="False" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#f0f0f0" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="100" Header="编号">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" FontSize="20" Text="{Binding SerialNumber}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="650" Header="测试项">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" FontSize="20" Text="{Binding JobName}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="50" Header="状态">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid HorizontalAlignment="Right">
                                            <Ellipse Width="24" Height="24">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#888888" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="1">
                                                                <Setter Property="Fill" Value="#f7c320" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="2">
                                                                <Setter Property="Fill" Value="#32b852" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="-1">
                                                                <Setter Property="Fill" Value="#e53935" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <Border Grid.Column="1" Margin="1" Background="#f8f8f8" />
            <TextBlock Grid.Column="2" MaxWidth="250" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="30" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                                <Setter Property="Foreground" Value="#999" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="0">
                                <Setter Property="Foreground" Value="#000000" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="1">
                                <Setter Property="Foreground" Value="#f7c320" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="2">
                                <Setter Property="Foreground" Value="#32b852" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="-1">
                                <Setter Property="Foreground" Value="#e53935" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <TextBlock.Text>
                    <Binding FallbackValue="未执行测试项目" Path="TestStatusInfo" TargetNullValue="未执行测试项目">
                        <Binding.Converter>
                            <conv:EmptyStringConverter />
                        </Binding.Converter>
                    </Binding>
                </TextBlock.Text>
            </TextBlock>
        </Grid>
    </Grid>
</Window>