<Window
    x:Class="TestingSoftware.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:TestingSoftware.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:TestingSoftware"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="clr-namespace:TestingSoftware.View"
    Width="1200"
    Height="600"
    mc:Ignorable="d">
    <Window.Resources>
        <conv:EmptyStringConverter x:Key="EmptyStringConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:BoolFalseToVisibilityConverter x:Key="BoolFalseToVisibilityConverter" />
        <LinearGradientBrush x:Key="xForeground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0" Color="#1E54C2" />
            <GradientStop Offset="1.0" Color="#072A77" />
        </LinearGradientBrush>
        <Style x:Key="xIcon" TargetType="{x:Type icon:PackIconBase}">
            <Setter Property="Foreground" Value="{StaticResource xForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <!--  新增：禁用状态 Trigger  -->
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#808080" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <!--  打开项目 (Ctrl+O)  -->
        <KeyBinding
            Key="O"
            Command="{Binding OpenAction}"
            Modifiers="Ctrl" />
        <!--  退出 (Alt+F4)  -->
        <KeyBinding
            Key="F4"
            Command="{Binding ExitAction}"
            Modifiers="Alt" />
    </Window.InputBindings>
    <Window.Title>
        <Binding Path="FileName" StringFormat="Testing Software - {0}" />
    </Window.Title>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <!--  Menu  -->
            <RowDefinition Height="auto" />
            <!--  大标题  -->
            <RowDefinition Height="4" />
            <!--  灰色分割线  -->
            <RowDefinition Height="auto" />
            <!--  ToolBar  -->
            <RowDefinition Height="4" />
            <!--  灰色分割线  -->

            <!--  TabControl  -->
            <RowDefinition Height="auto" />
            <RowDefinition Height="4" />
            <!--  灰色分割线  -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" HorizontalAlignment="Stretch">
            <!--  File  -->
            <MenuItem Header="文件">
                <MenuItem
                    Command="{Binding OpenAction}"
                    Header="打开文件"
                    InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem
                    Command="{Binding SaveAction}"
                    Header=" 保存"
                    InputGestureText="Ctrl+S" />
                <Separator />
                <MenuItem
                    Command="{Binding ExitAction}"
                    Header="退出"
                    InputGestureText="Alt+F4" />
            </MenuItem>
        </Menu>

        <TextBlock
            Grid.Row="1"
            Margin="10,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="22"
            FontWeight="Bold"
            Text="{Binding Model.Title, TargetNullValue='未命名项目'}" />

        <!--  标题与ToolBar之间灰色分隔线  -->
        <Border
            Grid.Row="2"
            Margin="0,1"
            HorizontalAlignment="Stretch"
            Background="#cccccc" />



        <DockPanel
            Grid.Row="3"
            Margin="5"
            HorizontalAlignment="Stretch">

            <!--  左侧原有全部内容  -->
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="20"
                    Text="串口" />
                <ComboBox
                    MinWidth="50"
                    Margin="5"
                    VerticalAlignment="Center"
                    FontSize="20"
                    ItemsSource="{Binding SerialPortList}"
                    SelectedItem="{Binding SelectedSerialPort}" />
                <Button
                    Width="100"
                    Height="50"
                    Margin="5"
                    Padding="5,3,5,3"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Command="{Binding ScanSerialAction}"
                    FontSize="20"
                    ToolTip="Scan"
                    Visibility="{Binding IsShowPidView, Converter={StaticResource BoolFalseToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconOcticons
                            Width="25"
                            Height="25"
                            Kind="Codescan"
                            Style="{StaticResource xIcon}" />
                        <TextBlock Margin="4,0,0,0" Text="扫描" />
                    </StackPanel>
                </Button>
                <StackPanel DataContext="{Binding BluetoothViewAdapter}" Orientation="Horizontal">
                    <TextBlock
                        Margin="5"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Text="测试设备:" />
                    <ComboBox
                        MinWidth="50"
                        Margin="5"
                        VerticalAlignment="Center"
                        FontSize="20"
                        IsEnabled="{Binding IsScanning}"
                        ItemsSource="{Binding SlaveDevices}"
                        SelectedItem="{Binding SelectedSlaveDevInfo}" />
                    <Button
                        Width="100"
                        Height="50"
                        Margin="5"
                        Padding="5,3,5,3"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Command="{Binding ScanAction}"
                        FontSize="20"
                        ToolTip="Scan">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconOcticons
                                Width="25"
                                Height="25"
                                Kind="Codescan"
                                Style="{StaticResource xIcon}" />
                            <TextBlock Margin="4,0,0,0" Text="扫描" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button
                        Width="100"
                        Height="50"
                        Margin="5"
                        Padding="5,3,5,3"
                        VerticalAlignment="Center"
                        Command="{Binding ConnectAction}"
                        FontSize="20"
                        ToolTip="{Binding ConnectionLabel}">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconPhosphorIcons
                                Width="25"
                                Height="25"
                                Kind="PlugsLight"
                                Style="{StaticResource xIcon}"
                                Visibility="{Binding IsConnectButtonEnabled, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <icon:PackIconPhosphorIcons
                                Width="25"
                                Height="25"
                                Kind="PlugsConnectedLight"
                                Style="{StaticResource xIcon}"
                                Visibility="{Binding IsConnectButtonEnabled, Converter={StaticResource BoolFalseToVisibilityConverter}}" />
                            <TextBlock Margin="4,0,0,0" Text="{Binding ConnectionLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </DockPanel>



        <!--  标题与ToolBar之间灰色分隔线  -->
        <Border
            Grid.Row="4"
            Margin="0,1"
            HorizontalAlignment="Stretch"
            Background="#cccccc" />
        <DockPanel Grid.Row="5" Margin="5">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="25"
                Text="SN：" />
            <TextBox
                Width="310"
                Height="40"
                Margin="8,0"
                VerticalAlignment="Center"
                FontSize="25"
                GotFocus="ScanSnTextBox_GotFocus"
                KeyDown="ScanSnTextBox_KeyDown"
                Text="{Binding ScanSn}" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="25"
                Text="复查数据：" />
            <TextBlock
                Width="150"
                VerticalAlignment="Center"
                Background="White"
                FontSize="25"
                FontWeight="Bold"
                Foreground="Red"
                Text="{Binding ReTestSn}" />

            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <Button
                    Width="100"
                    Height="50"
                    Margin="5"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Command="{Binding StartJobAction}"
                    FontSize="20"
                    ToolTip="开始任务">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconPhosphorIcons
                            Width="25"
                            Height="25"
                            Kind="PlayLight"
                            Style="{StaticResource xIcon}" />
                        <TextBlock Margin="4,0,0,0" Text="开始" />
                    </StackPanel>
                </Button>
                <Button
                    Width="100"
                    Height="50"
                    Margin="5"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Command="{Binding StopJobAction}"
                    FontSize="20"
                    ToolTip="停止任务">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconPhosphorIcons
                            Width="25"
                            Height="25"
                            Kind="StopLight"
                            Style="{StaticResource xIcon}" />
                        <TextBlock Margin="4,0,0,0" Text="停止" />
                    </StackPanel>
                </Button>
                <Button
                    Width="100"
                    Height="50"
                    Margin="5"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Command="{Binding RetestJobAction}"
                    FontSize="20"
                    ToolTip="复测当前任务">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconPhosphorIcons
                            Width="25"
                            Height="25"
                            Kind="RepeatLight"
                            Style="{StaticResource xIcon}" />
                        <TextBlock Margin="4,0,0,0" Text="复测" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!--  标题与ToolBar之间灰色分隔线  -->
        <Border
            Grid.Row="6"
            Margin="0,1"
            HorizontalAlignment="Stretch"
            Background="#cccccc" />
        <Grid Grid.Row="7">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <!--  列表本体  -->
            <ListView
                Grid.Column="0"
                ItemsSource="{Binding VisibleJobs}"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="IsSelected" Value="False" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#f0f0f0" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.View>
                    <GridView>
                        <!--  名称  -->
                        <GridViewColumn Width="100" Header="编号">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Text="{Binding SerialNumber}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="650" Header="测试项">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Text="{Binding JobName}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <!--  状态圆灯 Ellipse  -->
                        <GridViewColumn Width="50" Header="状态">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid Grid.Column="1" HorizontalAlignment="Right">
                                            <Ellipse Width="24" Height="24">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <!--  默认灰色 0:未执行  -->
                                                        <Setter Property="Fill" Value="#888888" />
                                                        <Style.Triggers>
                                                            <!--  1:执行中 黄色  -->
                                                            <DataTrigger Binding="{Binding Status}" Value="1">
                                                                <Setter Property="Fill" Value="#f7c320" />
                                                            </DataTrigger>
                                                            <!--  2:执行完成 绿色  -->
                                                            <DataTrigger Binding="{Binding Status}" Value="2">
                                                                <Setter Property="Fill" Value="#32b852" />
                                                            </DataTrigger>
                                                            <!--  -1:执行失败 红色  -->
                                                            <DataTrigger Binding="{Binding Status}" Value="-1">
                                                                <Setter Property="Fill" Value="#e53935" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>


                    </GridView>
                </ListView.View>
            </ListView>




            <!--  右侧区域，后续放Job详情、Signal表格等  -->
            <Border
                Grid.Column="1"
                Margin="1"
                Background="#f8f8f8" />

            <TextBlock
                Grid.Column="2"
                MaxWidth="250"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="30"
                TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <!--  CurrentJob为null，直接使用默认灰色，不执行下面状态触发器  -->
                            <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                                <Setter Property="Foreground" Value="#999" />
                            </DataTrigger>

                            <!--  只有CurrentJob不为null，下面触发器才有可能命中  -->

                            <DataTrigger Binding="{Binding Status}" Value="0">
                                <Setter Property="Foreground" Value="#000000" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="1">
                                <Setter Property="Foreground" Value="#f7c320" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="2">
                                <Setter Property="Foreground" Value="#32b852" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="-1">
                                <Setter Property="Foreground" Value="#e53935" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <TextBlock.Text>
                    <Binding
                        FallbackValue="未执行测试项目"
                        Path="TestStatusInfo"
                        TargetNullValue="未执行测试项目">
                        <Binding.Converter>
                            <conv:EmptyStringConverter />
                        </Binding.Converter>
                    </Binding>
                </TextBlock.Text>
            </TextBlock>
        </Grid>



    </Grid>

</Window>
