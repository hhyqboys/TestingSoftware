<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Motor Studio" Manufacturer="MS Team" Version="1.0.1.0" UpgradeCode="13137703-0c7a-4e10-b405-c9934fd9c405">

	  <!--The software opens automatically after installation.-->
	  <CustomAction Id="LaunchApplication"
				  Directory="INSTALLFOLDER"
				  ExeCommand="[INSTALLFOLDER]ElectricControl.exe"
				  Execute="immediate"
				  Return="asyncNoWait" />

	<InstallExecuteSequence>
		<Custom Action="LaunchApplication" After="InstallFinalize"></Custom>
	</InstallExecuteSequence>

    <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeError)" />

	  <!--Define the file access control list here. It can only be a build variable not a runtime variable-->
	  <WixVariable Id="DACL" Value="D:(A;OICI;FR;;;LS)(A;OICI;FA;;;BA)(A;OICI;FR;;;AU)"/>
	  <WixVariable Id="DACLALL" Value="D:(A;OICI;FR;;;LS)(A;OICI;FA;;;BA)(A;OICI;FA;;;AU)"/>
	 	
	<PropertyRef Id="WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED" />

	<Launch	Message="This application requires .NET Framework 4.8 or later."
			Condition="Installed OR WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED"/>

	  <Feature Id="Main">
		 <ComponentGroupRef Id="ElectricControl" />
		 <ComponentGroupRef Id="Runtimes"/>
		  
	  </Feature>


		<!--The application icon-->
		<Icon Id="ElectricControl.exe" SourceFile="Resources\ElectricControl.ico"/>
		
		<!--The application icon at installing-->
		<Property Id="ARPPRODUCTICON" Value="ElectricControl.exe"/>

		<!--The license declaration-->
		<WixVariable Id="WixUILicenseRtf" Value="!(loc.License)"/>
		
		<!--Select the install direction UI-->
		<ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER"/>

		<!--Make the cab file embedded into msi file-->
		<MediaTemplate EmbedCab="yes"/>
		
  </Package>
</Wix>
