<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
			
			<!--Define the install folder-->
			<Directory Id="INSTALLFOLDER" Name="!(bind.Property.ProductName)" >
      
			<!--Define runtime library-->
			<Directory Name="runtimes">
				<Directory Name="win">
					<Directory Name="lib">
						<Directory Id="RUNTIMESFOLDER"  Name="net8.0" />
					</Directory>
				</Directory>
			</Directory>
				
			<!--Define library folder-->
			<Directory Id="LIBFOLDER" Name="Lib" />
				
			<!--Define chinese resource folder-->
			<Directory Id="ZHCNFOLDER" Name="zh-CN" />

			<!--Define DE folder-->
			<Directory Id="DEFOLDER" Name="de" />
				
				<!--Define DE folder-->
				<Directory Id="TRFOLDER" Name="tr" />

			</Directory>
    </StandardDirectory>
  </Fragment>
</Wix>
