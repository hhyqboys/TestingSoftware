<UserControl
    x:Class="TestingSoftware.View.LineConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TestingSoftware.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="White"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="LineLoaded"
    mc:Ignorable="d">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  第一行 SN扫码区域  -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                Text="SN号：" />
            <TextBox
                x:Name="TxtSn"
                Width="200"
                Height="30"
                Margin="8,0"
                VerticalAlignment="Center"
                FontSize="20" Text="{Binding ScanSn, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                x:Name="BtnWriteSn"
                Width="100"
                Height="50"
                Command="{Binding WriteSigCommand}"
                Content="开始" />
        </DockPanel>

        <!--  列表：名称、值、状态  -->
        <ListView
            x:Name="LvConfigList"
            Grid.Row="1"
            AllowDrop="True"
            ItemsSource="{Binding SignalsView}">
            <ListView.View>
                <GridView>
                    <!--  名称  -->
                    <GridViewColumn Width="100" Header="编号">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" Text="{Binding Index}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="300" Header="名称">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!--  值：可编辑TextBox，LostFocus回写Model  -->
                    <GridViewColumn Width="300" Header="值">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" Text="{Binding DefaultValue}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                  
                </GridView>
            </ListView.View>
        </ListView>
        <!--  底部写入按钮  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,12,0,0"
            HorizontalAlignment="Center">
            <TextBlock
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontSize="30"
        Text="{Binding CurrentJob.ShowText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <!-- CurrentJob为null时兜底灰色 -->
                        <Setter Property="Foreground" Value="#999999"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentJob.Status}" Value="0">
                                <Setter Property="Foreground" Value="#000000"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentJob.Status}" Value="1">
                                <Setter Property="Foreground" Value="#f7c320"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentJob.Status}" Value="2">
                                <Setter Property="Foreground" Value="#32b852"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentJob.Status}" Value="-1">
                                <Setter Property="Foreground" Value="#e53935"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
