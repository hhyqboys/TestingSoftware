<Window
    x:Class="TestingSoftware.View.IoControlWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="440"
    Height="400"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Title="下位机 IO 控制"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="13"
            Foreground="#5A6472"
            Text="通过 2F 服务接管 ECU 的外部 IO 输入（GPIO），可与实时监控同时运行。"
            TextWrapping="Wrap" />

        <!--  油门  -->
        <GroupBox
            Grid.Row="1"
            Margin="0,0,0,10"
            Header="油门 0xD100">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Text="目标值" />
                <TextBox
                    Grid.Column="1"
                    Height="30"
                    VerticalContentAlignment="Center"
                    Text="{Binding TargetThrottle, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="2"
                    MinWidth="70"
                    Height="30"
                    Margin="8,0,0,0"
                    Command="{Binding SetThrottleAction}"
                    Content="接管" />
                <StackPanel
                    Grid.Column="3"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="90"
                        Height="30"
                        Command="{Binding ReturnThrottleAction}"
                        Content="交还 ECU" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#5A6472"
                        Text="{Binding ThrottleStateText}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!--  刹车  -->
        <GroupBox
            Grid.Row="2"
            Margin="0,0,0,10"
            Header="刹车 0xD101">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Text="目标值" />
                <TextBox
                    Grid.Column="1"
                    Height="30"
                    VerticalContentAlignment="Center"
                    Text="{Binding TargetBrake, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="2"
                    MinWidth="70"
                    Height="30"
                    Margin="8,0,0,0"
                    Command="{Binding SetBrakeAction}"
                    Content="接管" />
                <StackPanel
                    Grid.Column="3"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="90"
                        Height="30"
                        Command="{Binding ReturnBrakeAction}"
                        Content="交还 ECU" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#5A6472"
                        Text="{Binding BrakeStateText}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!--  档位  -->
        <GroupBox Grid.Row="3" Header="档位 0xD102">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Text="目标值" />
                <TextBox
                    Grid.Column="1"
                    Height="30"
                    VerticalContentAlignment="Center"
                    Text="{Binding TargetGear, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="2"
                    MinWidth="70"
                    Height="30"
                    Margin="8,0,0,0"
                    Command="{Binding SetGearAction}"
                    Content="接管" />
                <StackPanel
                    Grid.Column="3"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="90"
                        Height="30"
                        Command="{Binding ReturnGearAction}"
                        Content="交还 ECU" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#5A6472"
                        Text="{Binding GearStateText}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <Border
            Grid.Row="5"
            Margin="0,8,0,0"
            Padding="10,8"
            Background="#F4F7FB"
            CornerRadius="4">
            <TextBlock
                FontSize="13"
                Foreground="#3C4859"
                Text="{Binding StatusText}"
                TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
